# Kopiraj u .env i popuni stvarnim vrednostima.

# Glavni domen aplikacije (bez https://)
DOMAIN=mafija-etf.duckdns.org

# Poddomen ZA LIVEKIT (drugo, zasebno DuckDNS ime -> ISTA IP adresa VPS-a)
LIVEKIT_DOMAIN=mafija-etf-livekit.duckdns.org

# Isti par MORA da stoji i u deploy/livekit.yaml (kljuc "keys:") —
# generisi npr. sa: openssl rand -hex 16   (za oba, kljuc i tajnu, posebno)
LIVEKIT_API_KEY=menjaj-me-api-key
LIVEKIT_API_SECRET=menjaj-me-api-secret
