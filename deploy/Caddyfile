{$DOMAIN} {
	encode gzip

	# Sav Socket.IO saobracaj ide game serveru (interno ime servisa iz compose-a)
	handle /socket.io/* {
		reverse_proxy server:3001
	}

	# Sve ostalo: React aplikacija (SPA fallback na index.html)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# LiveKit signal (WS/HTTP) — zaseban poddomen, isti VPS. Caddy ovde samo
# terminira TLS i prosledjuje; stvaran medija (audio/video) saobracaj ide
# DIREKTNO na LiveKit-ove TCP/UDP portove, mimo Caddy-ja (vidi docker-compose.yml).
{$LIVEKIT_DOMAIN} {
	reverse_proxy livekit:7880
}
