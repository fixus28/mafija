# Faza 1: bildovanje React klijenta
FROM node:22-alpine AS build
WORKDIR /app
COPY . .
RUN npm ci
RUN npm run build -w @mafija/client

# Faza 2: Caddy sluzi staticne fajlove + proksira socket + automatski HTTPS
FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/packages/client/dist /srv
